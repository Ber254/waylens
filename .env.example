# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). For judging/dev use a debug token:
VITE_APPCHECK_DEBUG=true
VITE_RECAPTCHA_SITE_KEY=

# Cloud fallback model (check the Firebase AI Logic model list for current names)
# Comma-separated list is allowed: tried in order if a model is overloaded
VITE_CLOUD_MODEL=gemini-3.7-flash,gemini-3.5-flash-lite

# Dev-only fake backend so the UI can be tried without Firebase (never for submission video)
VITE_ENABLE_MOCK=false
